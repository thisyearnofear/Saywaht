# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/apps/web/node_modules

# next.js
/apps/web/.next/
/apps/web/out/

# debug
/apps/web/npm-debug.log*
/apps/web/yarn-debug.log*
/apps/web/yarn-error.log*

# env files (can opt-in for committing if needed)
/apps/web/.env*
!/apps/web/.env.example

# typescript
/apps/web/next-env.d.ts
/apps/web/yarn.lock
/apps/web/tsconfig.tsbuildinfo
*.tsbuildinfo

# asdf version management
.tool-versions

node_modules
.cursorignore
.turbo

*.env
**/.env.local
**/.env.*.local
dump.rdb

# Lock files (allow bun.lock, block others for consistency)
package-lock.json
yarn.lock

# Build artifacts and caches
*.tsbuildinfo
.next
out
dist
build

# Backup and temporary files
*.backup.js
*.complex.js
*.old
*.tmp

# AI, Editor and specific tools
.junie
.qodo
.github
.claude
.blackboxcli
.zencoder
.zenflow
.vscode
